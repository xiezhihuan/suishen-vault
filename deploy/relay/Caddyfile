{
	admin off
	persist_config off
	# 反向代理的错误日志会带上请求头（X-Auth-Code 不在 Caddy 的自动打码名单里），必须排除。
	# 也不要给站点加 log 指令：访问日志会记下来访地址。
	log default {
		exclude http
	}
}

{$RELAY_HOST} {
	tls {
		protocols tls1.3
	}
	# 隧道是长连接，Caddy 默认不限时，不需要额外设置
	reverse_proxy {$RELAY_UPSTREAM:relay:7470}

	# 跳板进程没在运行时，答复也与离线相同
	handle_errors 502 503 504 {
		header Content-Type application/json
		header Cache-Control no-store
		header X-Content-Type-Options nosniff
		respond `{"error":"unavailable"}` 503
	}
}
