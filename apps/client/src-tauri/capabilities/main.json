{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "主窗口最小权限：逐条列出本应用自己的命令，不开放任何 Tauri 内置能力与插件命令",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-poll",
    "allow-touch",
    "allow-setup-begin",
    "allow-setup-confirm",
    "allow-cancel-flow",
    "allow-unlock",
    "allow-lock",
    "allow-recovery-begin",
    "allow-recovery-reissue",
    "allow-recovery-confirm",
    "allow-change-password",
    "allow-list-items",
    "allow-get-item",
    "allow-reveal-field",
    "allow-copy-field",
    "allow-copy-text",
    "allow-save-item",
    "allow-item-action",
    "allow-empty-trash",
    "allow-totp-code",
    "allow-generate",
    "allow-open-service",
    "allow-close-service",
    "allow-list-clients",
    "allow-add-client",
    "allow-rename-client",
    "allow-revoke-client",
    "allow-resume-client",
    "allow-decide",
    "allow-request-state",
    "allow-audit",
    "allow-mcp-config",
    "allow-import-csv",
    "allow-delete-csv",
    "allow-export-backup",
    "allow-pick-package",
    "allow-restore-backup",
    "allow-migration-import",
    "allow-migration-begin",
    "allow-migration-cancel",
    "allow-migration-confirm",
    "allow-wipe-retired",
    "allow-set-aside",
    "allow-set-settings"
  ]
}
